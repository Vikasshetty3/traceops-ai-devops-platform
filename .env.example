# =================================================================
# TraceOps Platform Environment Template (.env.example)
# Copy this file to backend/.env and populate with your production values.
# NEVER commit production API keys, secrets, or credentials to version control.
# =================================================================

# Application Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# CORS Allowed Origins (Comma-separated list; strictly no '*' in authenticated production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (MongoDB)
# In production, use authenticated MongoDB URI (e.g., mongodb://user:pass@host:27017/db?authSource=admin)
MONGODB_URI=mongodb://127.0.0.1:27017/requirement_traceable_devops

# Authentication & JWT Configuration
# Required in production: Minimum 16 characters, cryptographically random
JWT_SECRET=your_strong_jwt_secret_min_16_chars_here
JWT_EXPIRES_IN=7d

# First Administrator Initialization Secret (Optional)
# If configured, operator must provide this token when registering the initial admin account
ADMIN_INIT_SECRET=

# Artificial Intelligence (Google Gemini)
# Obtain your key securely from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Observability (Prometheus)
PROMETHEUS_URL=http://prometheus:9090

# Machine Learning Microservice
ML_SERVICE_URL=http://ml-service:5001
MODEL_ARTIFACT_ROOT=data

# DevOps Execution Layer
# Options: "simulation" (safe local dev default) | "kubernetes" (live cluster integration)
DEVOPS_PROVIDER=simulation
DOCKER_SANDBOX_NETWORK=none

# API Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_API_MAX=100
RATE_LIMIT_AI_MAX=20

# Production Reverse Proxy & Domain Configuration (Caddy)
DOMAIN_NAME=example.com
ACME_EMAIL=admin@example.com

# Observability Dashboard (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# Release & Immutable Image Tagging
RELEASE_VERSION=1.0.0
GIT_COMMIT_SHA=

