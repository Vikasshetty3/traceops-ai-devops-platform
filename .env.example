# =================================================================
# TraceOps Platform Environment Template (.env.example)
# Copy this file to backend/.env and populate with your local values.
# NEVER commit production API keys or credentials to version control.
# =================================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/requirement_traceable_devops

# Artificial Intelligence (Google Gemini)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Machine Learning Microservice
ML_SERVICE_URL=http://localhost:5001

# DevOps Execution Layer
# Options: "simulation" (safe local dev default) | "kubernetes" (live cluster integration)
DEVOPS_PROVIDER=simulation

# Kubernetes Cluster Configuration (used when DEVOPS_PROVIDER=kubernetes)
KUBERNETES_NAMESPACE=requirement-traceable-devops
KUBERNETES_API_SERVER=http://127.0.0.1:8001
KUBERNETES_BEARER_TOKEN=

# Security & JWT Token Signing
JWT_SECRET=your_jwt_secret_key_here
