{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  },
  "include": [
    "src/**/*",
    "../devops-adapter/**/*",
    "../experiment-engine/**/*",
    "../ml-service/src/model.ts"
  ],
  "exclude": ["node_modules", "dist"]
}